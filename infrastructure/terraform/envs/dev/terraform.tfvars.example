# Ejemplo de parámetros. terraform.tfvars (versionado) contiene los valores no
# secretos del ambiente dev; usar este archivo como referencia de lo que se puede
# ajustar. Ningún valor aquí es secreto.

aws_region     = "us-east-2"
aws_account_id = "055147668929"
environment    = "dev"
cluster_name   = "usn-cluster"

kubernetes_version = "1.35"
# Restringir a la IP de administración, p. ej. ["203.0.113.10/32"], solo si el
# CD no usa runners hospedados de GitHub.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# Plan gratuito: solo tipos free-tier (aws ec2 describe-instance-types --filters Name=free-tier-eligible,Values=true).
node_instance_types = ["c7i-flex.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
node_disk_size      = 20

app_namespace = "usn"

ecr_repositories     = ["usn-backend", "usn-frontend", "usn-socket", "usn-ai-service"]
ecr_keep_last_images = 15

db_engine_version        = "8.0"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 50
db_name                  = "railway"
db_username              = "usn"
db_multi_az              = false
db_backup_retention_days = 1
db_skip_final_snapshot   = true

# iam_user: esta cuenta bloquea OIDC. Cambiar a oidc en cuentas que lo permitan.
github_auth_mode            = "iam_user"
github_repository           = "ancelcruzch/usn-aws-deployment"
github_deploy_branch        = "main"
create_github_oidc_provider = true

log_retention_days = 7
# Correos para alarmas y presupuesto (cada uno debe confirmar la suscripción SNS).
alert_emails       = []
monthly_budget_usd = 100
