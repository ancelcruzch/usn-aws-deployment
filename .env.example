# Plantilla para desarrollo local con docker compose.
# Copiar a .env (ignorado por Git) y completar. No subir valores reales.

# Contraseña de MySQL local (solo para docker compose).
MYSQL_ROOT_PASSWORD=cambiar-esta-clave

# Cloudinary (subida de imágenes). Obtener en https://console.cloudinary.com
# → Settings → API Keys. Opcional: sin ellas, la app funciona pero no sube imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
